pipeline {
  agent none

  options {
    timeout(time: 10, unit: 'MINUTES')
    disableConcurrentBuilds(abortPrevious: true)
  }

  environment {
    COVERAGE_MIN = '75'
    npm_config_cache = '/tmp/.npm'
  }

  stages {
    stage('API - Matrice Node 20 & 22') {
      matrix {
        axes {
          axis {
            name 'NODE_VERSION'
            values '20', '22'
          }
        }
        stages {
          stage('Lint & Tests unitaires') {
            agent {
              docker {
                image "node:${NODE_VERSION}-alpine"
              }
            }
            steps {
              dir('api') {
                sh 'npm ci'
                sh 'npm run lint'
                sh 'npm run format:check'
                sh 'npm run test:coverage'
              }
            }
          }
        }
      }
    }

    stage('API - Tests intégration Postgres') {
      agent {
        docker {
          image 'node:20-alpine'
        }
      }
      steps {
        script {
          docker.image('postgres:16-alpine').withRun(
            '-e POSTGRES_USER=taskflow -e POSTGRES_PASSWORD=taskflow -e POSTGRES_DB=taskflow'
          ) { db ->
            docker.image('node:20-alpine').inside("--link ${db.id}:postgres") {
              dir('api') {
                sh 'npm ci'
                sh 'DATABASE_URL=postgres://taskflow:taskflow@postgres:5432/taskflow npm run test:int'
              }
            }
          }
        }
      }
    }

    stage('Front - Build & Artefact') {
      agent {
        docker {
          image 'node:20-alpine'
        }
      }
      steps {
        dir('front') {
          sh 'npm ci'
          sh 'npm run lint'
          sh 'npm run format:check'
          sh 'npm run test:coverage'
          sh 'npm run build'
        }
        archiveArtifacts artifacts: 'front/dist/**', allowEmptyArchive: false
      }
    }
  }
}